{
  "$defs": {
    "EditSemanticNoveltyViewV1": {
      "additionalProperties": false,
      "properties": {
        "attachment_profile": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "fragmentation_profile": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "normalized_edit_signature": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "reaction_centre_neighbourhood": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "ring_change_profile": {
          "$ref": "#/$defs/NoveltyMetricV1"
        }
      },
      "required": [
        "normalized_edit_signature",
        "reaction_centre_neighbourhood",
        "ring_change_profile",
        "fragmentation_profile",
        "attachment_profile"
      ],
      "title": "EditSemanticNoveltyViewV1",
      "type": "object"
    },
    "EvidenceAvailability": {
      "enum": [
        "available",
        "unavailable",
        "indeterminate",
        "unsupported"
      ],
      "title": "EvidenceAvailability",
      "type": "string"
    },
    "FingerprintSpecificationV1": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "minLength": 1,
          "title": "Algorithm",
          "type": "string"
        },
        "bit_length": {
          "exclusiveMinimum": 0,
          "title": "Bit Length",
          "type": "integer"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "implementation_version": {
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "radius": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "schema_version": {
          "const": "synthaudit.fingerprint-specification/1",
          "default": "synthaudit.fingerprint-specification/1",
          "title": "Schema Version",
          "type": "string"
        },
        "use_chirality": {
          "title": "Use Chirality",
          "type": "boolean"
        }
      },
      "required": [
        "algorithm",
        "bit_length",
        "use_chirality",
        "implementation",
        "implementation_version"
      ],
      "title": "FingerprintSpecificationV1",
      "type": "object"
    },
    "JsonValue": {},
    "LearnedTransformationNoveltyViewV1": {
      "additionalProperties": false,
      "properties": {
        "reactseq_meo": {
          "$ref": "#/$defs/NoveltyMetricV1"
        }
      },
      "required": [
        "reactseq_meo"
      ],
      "title": "LearnedTransformationNoveltyViewV1",
      "type": "object"
    },
    "NoveltyMetricV1": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/EvidenceAvailability"
        },
        "interpretation": {
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "maximum_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Similarity"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "nearest_reference_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Nearest Reference Ids",
          "type": "array"
        },
        "novelty": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Novelty"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "schema_version": {
          "const": "synthaudit.novelty-metric/1",
          "default": "synthaudit.novelty-metric/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "availability",
        "method",
        "interpretation"
      ],
      "title": "NoveltyMetricV1",
      "type": "object"
    },
    "PrecedentHitV1": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReactionConditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_license_status": {
          "title": "Data License Status",
          "type": "string"
        },
        "fingerprint_specification": {
          "$ref": "#/$defs/FingerprintSpecificationV1"
        },
        "interpretation": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Interpretation",
          "type": "array"
        },
        "leaving_group_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leaving Group Similarity"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "product_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Similarity"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "reaction_centre_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Centre Similarity"
        },
        "reaction_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Class"
        },
        "reported_yield": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Yield"
        },
        "schema_version": {
          "const": "synthaudit.precedent-hit/1",
          "default": "synthaudit.precedent-hit/1",
          "title": "Schema Version",
          "type": "string"
        },
        "similarity_methods": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Similarity Methods",
          "type": "object"
        },
        "source_dataset": {
          "title": "Source Dataset",
          "type": "string"
        },
        "source_reaction_id": {
          "title": "Source Reaction Id",
          "type": "string"
        },
        "stereo_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stereo Similarity"
        },
        "substrate_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substrate Similarity"
        },
        "transformation_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Similarity"
        }
      },
      "required": [
        "source_dataset",
        "source_reaction_id",
        "data_license_status",
        "similarity_methods",
        "fingerprint_specification"
      ],
      "title": "PrecedentHitV1",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "ReactionConditions": {
      "additionalProperties": false,
      "description": "Structured conditions while retaining source-level text.",
      "properties": {
        "atmosphere": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atmosphere"
        },
        "catalysts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Catalysts",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "pressure_bar": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Bar"
        },
        "reagents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reagents",
          "type": "array"
        },
        "solvents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Solvents",
          "type": "array"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "time_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Hours"
        }
      },
      "title": "ReactionConditions",
      "type": "object"
    },
    "ReactionDifferenceNoveltyViewV1": {
      "additionalProperties": false,
      "properties": {
        "changed_bond_and_atom": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "drfp": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "reaction_difference": {
          "$ref": "#/$defs/NoveltyMetricV1"
        }
      },
      "required": [
        "reaction_difference",
        "changed_bond_and_atom",
        "drfp"
      ],
      "title": "ReactionDifferenceNoveltyViewV1",
      "type": "object"
    },
    "StructureNoveltyViewV1": {
      "additionalProperties": false,
      "properties": {
        "precursor_morgan": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "precursor_scaffold": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "product_morgan": {
          "$ref": "#/$defs/NoveltyMetricV1"
        },
        "product_scaffold": {
          "$ref": "#/$defs/NoveltyMetricV1"
        }
      },
      "required": [
        "product_morgan",
        "precursor_morgan",
        "product_scaffold",
        "precursor_scaffold"
      ],
      "title": "StructureNoveltyViewV1",
      "type": "object"
    },
    "TaxonomyRecognitionV1": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/EvidenceAvailability"
        },
        "class_frequency": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Frequency"
        },
        "class_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Label"
        },
        "interpretation": {
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_raw_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Raw Score"
        },
        "recognized": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognized"
        },
        "schema_version": {
          "const": "synthaudit.taxonomy-recognition/1",
          "default": "synthaudit.taxonomy-recognition/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "availability",
        "interpretation"
      ],
      "title": "TaxonomyRecognitionV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "minLength": 1,
      "title": "Corpus Id",
      "type": "string"
    },
    "corpus_version": {
      "minLength": 1,
      "title": "Corpus Version",
      "type": "string"
    },
    "edit_semantic_novelty": {
      "$ref": "#/$defs/EditSemanticNoveltyViewV1"
    },
    "interpretations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Interpretations",
      "type": "array"
    },
    "learned_transformation_novelty": {
      "$ref": "#/$defs/LearnedTransformationNoveltyViewV1"
    },
    "notice": {
      "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "title": "Notice",
      "type": "string"
    },
    "primary_baseline": {
      "const": "one_minus_maximum_reference_tanimoto",
      "default": "one_minus_maximum_reference_tanimoto",
      "title": "Primary Baseline",
      "type": "string"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "reaction_difference_novelty": {
      "$ref": "#/$defs/ReactionDifferenceNoveltyViewV1"
    },
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthaudit.multi-view-novelty/1",
      "default": "synthaudit.multi-view-novelty/1",
      "title": "Schema Version",
      "type": "string"
    },
    "structure_novelty": {
      "$ref": "#/$defs/StructureNoveltyViewV1"
    },
    "taxonomy_recognition": {
      "$ref": "#/$defs/TaxonomyRecognitionV1"
    },
    "top_precedents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PrecedentHitV1"
      },
      "title": "Top Precedents",
      "type": "array"
    }
  },
  "required": [
    "reaction_id",
    "corpus_id",
    "corpus_version",
    "structure_novelty",
    "reaction_difference_novelty",
    "edit_semantic_novelty",
    "learned_transformation_novelty",
    "taxonomy_recognition"
  ],
  "title": "MultiViewNoveltyResultV1",
  "type": "object"
}
