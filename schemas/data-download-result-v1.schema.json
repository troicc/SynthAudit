{
  "$defs": {
    "DownloadedArtifactV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "license_status": {
          "title": "License Status",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "destination",
        "sha256",
        "byte_length",
        "source_uri",
        "license_status"
      ],
      "title": "DownloadedArtifactV1",
      "type": "object"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/DownloadedArtifactV1"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "network_access_used": {
      "title": "Network Access Used",
      "type": "boolean"
    },
    "notice": {
      "const": "Data acquisition requires an explicit manifest, license status and checksum; downloaded reactions are not experimental validation.",
      "default": "Data acquisition requires an explicit manifest, license status and checksum; downloaded reactions are not experimental validation.",
      "title": "Notice",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "schema_version": {
      "const": "synthaudit.data-download-result/1",
      "default": "synthaudit.data-download-result/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "network_access_used",
    "artifacts",
    "provenance"
  ],
  "title": "DataDownloadResultV1",
  "type": "object"
}
