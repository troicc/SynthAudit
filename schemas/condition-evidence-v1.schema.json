{
  "$defs": {
    "EvidenceAvailability": {
      "enum": [
        "available",
        "unavailable",
        "indeterminate",
        "unsupported"
      ],
      "title": "EvidenceAvailability",
      "type": "string"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "ReactionConditions": {
      "additionalProperties": false,
      "description": "Structured conditions while retaining source-level text.",
      "properties": {
        "atmosphere": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atmosphere"
        },
        "catalysts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Catalysts",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "pressure_bar": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Bar"
        },
        "reagents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reagents",
          "type": "array"
        },
        "solvents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Solvents",
          "type": "array"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "time_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Hours"
        }
      },
      "title": "ReactionConditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "$ref": "#/$defs/EvidenceAvailability"
    },
    "conditions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReactionConditions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "missing_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Reasons",
      "type": "array"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "schema_version": {
      "const": "synthaudit.condition-evidence/1",
      "default": "synthaudit.condition-evidence/1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reaction_id": {
      "title": "Source Reaction Id",
      "type": "string"
    },
    "transfer_interpretation": {
      "title": "Transfer Interpretation",
      "type": "string"
    }
  },
  "required": [
    "source_reaction_id",
    "availability",
    "transfer_interpretation"
  ],
  "title": "ConditionEvidenceV1",
  "type": "object"
}
