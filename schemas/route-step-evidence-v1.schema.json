{
  "$defs": {
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Optional, separately sourced evidence for one route step.",
  "properties": {
    "calibrated_evidence_support_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibrated Evidence Support Score"
    },
    "missing_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Reasons",
      "type": "array"
    },
    "novelty_interpretation": {
      "const": "Corpus-relative novelty is independent of plausibility.",
      "default": "Corpus-relative novelty is independent of plausibility.",
      "title": "Novelty Interpretation",
      "type": "string"
    },
    "product_novelty": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Novelty"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "schema_version": {
      "const": "synthaudit.route-step-evidence/1",
      "default": "synthaudit.route-step-evidence/1",
      "title": "Schema Version",
      "type": "string"
    },
    "step_id": {
      "minLength": 1,
      "title": "Step Id",
      "type": "string"
    },
    "support_interpretation": {
      "const": "Calibrated evidence support; not an experimental feasibility probability.",
      "default": "Calibrated evidence support; not an experimental feasibility probability.",
      "title": "Support Interpretation",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "required": [
    "step_id"
  ],
  "title": "RouteStepEvidenceV1",
  "type": "object"
}
