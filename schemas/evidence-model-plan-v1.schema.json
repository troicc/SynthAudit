{
  "$defs": {
    "CalibrationMethod": {
      "enum": [
        "none",
        "platt",
        "isotonic"
      ],
      "title": "CalibrationMethod",
      "type": "string"
    },
    "EstimatorFamily": {
      "enum": [
        "logistic_regression",
        "hist_gradient_boosting_classifier"
      ],
      "title": "EstimatorFamily",
      "type": "string"
    },
    "EvidenceExampleSplit": {
      "enum": [
        "train",
        "calibration",
        "test",
        "ood_scaffold",
        "ood_reaction_class"
      ],
      "title": "EvidenceExampleSplit",
      "type": "string"
    },
    "EvidenceModelRole": {
      "enum": [
        "corpus_familiarity_baseline",
        "deterministic_structural_check_baseline",
        "reaction_centre_evidence_model",
        "completion_evidence_model",
        "stereo_evidence_model",
        "full_evidence_ensemble"
      ],
      "title": "EvidenceModelRole",
      "type": "string"
    },
    "EvidenceStage": {
      "enum": [
        "reaction_centre_supported",
        "completion_supported_given_reaction_centre",
        "stereo_specification_supported",
        "route_context_supported"
      ],
      "title": "EvidenceStage",
      "type": "string"
    },
    "EvidenceStagePlanV1": {
      "additionalProperties": false,
      "properties": {
        "calibration_methods": {
          "items": {
            "$ref": "#/$defs/CalibrationMethod"
          },
          "minItems": 1,
          "title": "Calibration Methods",
          "type": "array"
        },
        "estimator_families": {
          "items": {
            "$ref": "#/$defs/EstimatorFamily"
          },
          "minItems": 1,
          "title": "Estimator Families",
          "type": "array"
        },
        "feature_groups": {
          "items": {
            "$ref": "#/$defs/FeatureGroup"
          },
          "minItems": 1,
          "title": "Feature Groups",
          "type": "array"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/EvidenceModelRole"
        },
        "stage": {
          "$ref": "#/$defs/EvidenceStage"
        }
      },
      "required": [
        "stage",
        "role",
        "estimator_families",
        "calibration_methods",
        "feature_groups",
        "random_seed"
      ],
      "title": "EvidenceStagePlanV1",
      "type": "object"
    },
    "FeatureGroup": {
      "enum": [
        "corpus_familiarity",
        "structural",
        "reaction_centre",
        "completion",
        "stereo",
        "condition",
        "precedent",
        "forward_model",
        "provider_agreement",
        "route"
      ],
      "title": "FeatureGroup",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstention_threshold_source": {
      "const": "held_out_calibration",
      "default": "held_out_calibration",
      "title": "Abstention Threshold Source",
      "type": "string"
    },
    "baseline_roles": {
      "items": {
        "$ref": "#/$defs/EvidenceModelRole"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Baseline Roles",
      "type": "array"
    },
    "bootstrap_grouping": {
      "const": "parent_group_id",
      "default": "parent_group_id",
      "title": "Bootstrap Grouping",
      "type": "string"
    },
    "bootstrap_member_count": {
      "minimum": 2,
      "title": "Bootstrap Member Count",
      "type": "integer"
    },
    "mandatory_notice": {
      "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "title": "Mandatory Notice",
      "type": "string"
    },
    "model_selection_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Model Selection Status",
      "type": "string"
    },
    "ood_splits": {
      "items": {
        "$ref": "#/$defs/EvidenceExampleSplit"
      },
      "minItems": 1,
      "title": "Ood Splits",
      "type": "array"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthaudit.evidence-model-plan/1",
      "default": "synthaudit.evidence-model-plan/1",
      "title": "Schema Version",
      "type": "string"
    },
    "split_grouping": {
      "const": "parent_group_id",
      "default": "parent_group_id",
      "title": "Split Grouping",
      "type": "string"
    },
    "stage_models": {
      "items": {
        "$ref": "#/$defs/EvidenceStagePlanV1"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Stage Models",
      "type": "array"
    },
    "status": {
      "const": "contract_only_no_trained_research_artifact",
      "default": "contract_only_no_trained_research_artifact",
      "title": "Status",
      "type": "string"
    },
    "test_split_use": {
      "const": "evaluation_only_no_calibration_or_threshold_selection",
      "default": "evaluation_only_no_calibration_or_threshold_selection",
      "title": "Test Split Use",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "baseline_roles",
    "stage_models",
    "bootstrap_member_count",
    "ood_splits"
  ],
  "title": "EvidenceModelPlanV1",
  "type": "object"
}
