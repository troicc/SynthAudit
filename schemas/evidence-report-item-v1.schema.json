{
  "$defs": {
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A report-safe evidence item whose semantics cannot imply experimental success.",
  "properties": {
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "abstention_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Abstention Reasons",
      "type": "array"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable",
        "indeterminate"
      ],
      "title": "Availability",
      "type": "string"
    },
    "calibrated_evidence_support_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibrated Evidence Support Score"
    },
    "interpretation": {
      "const": "Evidence support and uncertainty; not an experimental feasibility probability.",
      "default": "Evidence support and uncertainty; not an experimental feasibility probability.",
      "title": "Interpretation",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "stage": {
      "enum": [
        "reaction_centre",
        "completion",
        "stereo",
        "route_context"
      ],
      "title": "Stage",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "required": [
    "stage",
    "availability",
    "abstained"
  ],
  "title": "EvidenceReportItemV1",
  "type": "object"
}
