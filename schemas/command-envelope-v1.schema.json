{
  "$defs": {
    "CommandErrorV1": {
      "additionalProperties": false,
      "properties": {
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "CommandErrorV1",
      "type": "object"
    },
    "CommandStatus": {
      "enum": [
        "ok",
        "error",
        "unavailable"
      ],
      "title": "CommandStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Uniform JSON/Rich boundary for product-facing commands.",
  "properties": {
    "command": {
      "minLength": 1,
      "title": "Command",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandErrorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notice": {
      "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
      "title": "Notice",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "schema_version": {
      "const": "synthaudit.command-envelope/1",
      "default": "synthaudit.command-envelope/1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    }
  },
  "required": [
    "command",
    "status",
    "provenance"
  ],
  "title": "CommandEnvelopeV1",
  "type": "object"
}
