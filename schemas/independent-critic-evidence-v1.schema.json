{
  "$defs": {
    "CriticJudgement": {
      "enum": [
        "supported",
        "unsupported",
        "indeterminate"
      ],
      "title": "CriticJudgement",
      "type": "string"
    },
    "CriticSampleV1": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "judgement": {
          "$ref": "#/$defs/CriticJudgement"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "raw_response": {
          "minLength": 1,
          "title": "Raw Response",
          "type": "string"
        },
        "reported_cost_usd": {
          "minimum": 0,
          "title": "Reported Cost Usd",
          "type": "number"
        },
        "sample_index": {
          "minimum": 0,
          "title": "Sample Index",
          "type": "integer"
        }
      },
      "required": [
        "sample_index",
        "judgement",
        "rationale",
        "raw_response",
        "input_tokens",
        "output_tokens",
        "reported_cost_usd"
      ],
      "title": "CriticSampleV1",
      "type": "object"
    },
    "EvidenceAvailability": {
      "enum": [
        "available",
        "unavailable",
        "indeterminate",
        "unsupported"
      ],
      "title": "EvidenceAvailability",
      "type": "string"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "$ref": "#/$defs/EvidenceAvailability"
    },
    "independent_from_generation_provider": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Independent From Generation Provider"
    },
    "missing_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Reasons",
      "type": "array"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "samples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CriticSampleV1"
      },
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": "synthaudit.independent-critic-evidence/1",
      "default": "synthaudit.independent-critic-evidence/1",
      "title": "Schema Version",
      "type": "string"
    },
    "sole_plausibility_source_permitted": {
      "const": false,
      "default": false,
      "title": "Sole Plausibility Source Permitted",
      "type": "boolean"
    },
    "total_input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Total Input Tokens",
      "type": "integer"
    },
    "total_output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Total Output Tokens",
      "type": "integer"
    },
    "total_reported_cost_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Total Reported Cost Usd",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "provider_id",
    "availability"
  ],
  "title": "IndependentCriticEvidenceV1",
  "type": "object"
}
