{
  "$defs": {
    "BenchmarkLabel": {
      "enum": [
        "recorded_reaction",
        "generated_counterfactual"
      ],
      "title": "BenchmarkLabel",
      "type": "string"
    },
    "CalibrationMethod": {
      "enum": [
        "none",
        "platt",
        "isotonic"
      ],
      "title": "CalibrationMethod",
      "type": "string"
    },
    "CounterfactualBenchmarkValidationV1": {
      "additionalProperties": false,
      "properties": {
        "category_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/CounterfactualCategory"
          },
          "title": "Category Counts",
          "type": "object"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "evaluation_slice_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/EvaluationSlice"
          },
          "title": "Evaluation Slice Counts",
          "type": "object"
        },
        "human_review_row_count": {
          "minimum": 0,
          "title": "Human Review Row Count",
          "type": "integer"
        },
        "label_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/BenchmarkLabel"
          },
          "title": "Label Counts",
          "type": "object"
        },
        "leakage_checks": {
          "const": "passed",
          "default": "passed",
          "title": "Leakage Checks",
          "type": "string"
        },
        "method_count": {
          "minimum": 0,
          "title": "Method Count",
          "type": "integer"
        },
        "metrics_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Metrics Status",
          "type": "string"
        },
        "notice": {
          "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "title": "Notice",
          "type": "string"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "records_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Records Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "synthaudit.counterfactual-benchmark-validation/1",
          "default": "synthaudit.counterfactual-benchmark-validation/1",
          "title": "Schema Version",
          "type": "string"
        },
        "split_partition_counts": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/$defs/DatasetPartition"
            },
            "type": "object"
          },
          "title": "Split Partition Counts",
          "type": "object"
        },
        "valid": {
          "const": true,
          "default": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "record_count",
        "records_sha256",
        "label_counts",
        "category_counts",
        "method_count",
        "split_partition_counts",
        "evaluation_slice_counts",
        "human_review_row_count"
      ],
      "title": "CounterfactualBenchmarkValidationV1",
      "type": "object"
    },
    "CounterfactualCategory": {
      "enum": [
        "representation",
        "reaction_centre",
        "completion",
        "stereo",
        "route"
      ],
      "title": "CounterfactualCategory",
      "type": "string"
    },
    "DatasetPartition": {
      "enum": [
        "train",
        "calibration",
        "test"
      ],
      "title": "DatasetPartition",
      "type": "string"
    },
    "EstimatorFamily": {
      "enum": [
        "logistic_regression",
        "hist_gradient_boosting_classifier"
      ],
      "title": "EstimatorFamily",
      "type": "string"
    },
    "EvaluationAvailability": {
      "enum": [
        "fixture_observation",
        "not_run"
      ],
      "title": "EvaluationAvailability",
      "type": "string"
    },
    "EvaluationSlice": {
      "enum": [
        "high_novelty_test",
        "ring_forming_test",
        "stereo_sensitive_test"
      ],
      "title": "EvaluationSlice",
      "type": "string"
    },
    "EvidenceModelContractSmokeV1": {
      "additionalProperties": false,
      "properties": {
        "ablation_contract_count": {
          "minimum": 1,
          "title": "Ablation Contract Count",
          "type": "integer"
        },
        "abstention_exercised": {
          "title": "Abstention Exercised",
          "type": "boolean"
        },
        "bootstrap_member_count": {
          "minimum": 2,
          "title": "Bootstrap Member Count",
          "type": "integer"
        },
        "calibrated_score_semantics": {
          "const": "calibrated_evidence_support_score_not_experimental_probability",
          "default": "calibrated_evidence_support_score_not_experimental_probability",
          "title": "Calibrated Score Semantics",
          "type": "string"
        },
        "calibration_methods_exercised": {
          "items": {
            "$ref": "#/$defs/CalibrationMethod"
          },
          "title": "Calibration Methods Exercised",
          "type": "array"
        },
        "estimator_families_exercised": {
          "items": {
            "$ref": "#/$defs/EstimatorFamily"
          },
          "title": "Estimator Families Exercised",
          "type": "array"
        },
        "metrics_status": {
          "const": "not_reportable_software_fixture",
          "default": "not_reportable_software_fixture",
          "title": "Metrics Status",
          "type": "string"
        },
        "missing_flags_exercised": {
          "title": "Missing Flags Exercised",
          "type": "boolean"
        },
        "notice": {
          "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "title": "Notice",
          "type": "string"
        },
        "ood_evaluation_contract_exercised": {
          "title": "Ood Evaluation Contract Exercised",
          "type": "boolean"
        },
        "provider_disagreement_exercised": {
          "title": "Provider Disagreement Exercised",
          "type": "boolean"
        },
        "raw_score_semantics": {
          "const": "uncalibrated_model_score",
          "default": "uncalibrated_model_score",
          "title": "Raw Score Semantics",
          "type": "string"
        },
        "schema_version": {
          "const": "synthaudit.evidence-model-contract-smoke/1",
          "default": "synthaudit.evidence-model-contract-smoke/1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage_model_count": {
          "const": 4,
          "default": 4,
          "title": "Stage Model Count",
          "type": "integer"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/EvidenceStage"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "stages",
        "estimator_families_exercised",
        "calibration_methods_exercised",
        "bootstrap_member_count",
        "missing_flags_exercised",
        "provider_disagreement_exercised",
        "abstention_exercised",
        "ood_evaluation_contract_exercised",
        "ablation_contract_count"
      ],
      "title": "EvidenceModelContractSmokeV1",
      "type": "object"
    },
    "EvidenceStage": {
      "enum": [
        "reaction_centre_supported",
        "completion_supported_given_reaction_centre",
        "stereo_specification_supported",
        "route_context_supported"
      ],
      "title": "EvidenceStage",
      "type": "string"
    },
    "JsonValue": {},
    "PromptBenchmarkValidationV1": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "cases_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cases Sha256",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "metrics_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Metrics Status",
          "type": "string"
        },
        "notice": {
          "const": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "default": "SynthAudit estimates representation validity, corpus novelty and evidence-based plausibility. It does not establish experimental feasibility, yield, selectivity, safety or scalability.",
          "title": "Notice",
          "type": "string"
        },
        "parent_group_atomicity": {
          "const": "passed",
          "default": "passed",
          "title": "Parent Group Atomicity",
          "type": "string"
        },
        "schema_version": {
          "const": "synthaudit.prompt-benchmark-validation/1",
          "default": "synthaudit.prompt-benchmark-validation/1",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "const": true,
          "default": true,
