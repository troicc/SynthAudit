          "propertyNames": {
            "$ref": "#/$defs/PromptVariantKind"
          },
          "title": "Variant Kind Counts",
          "type": "object"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "case_count",
        "variant_count",
        "variant_kind_counts",
