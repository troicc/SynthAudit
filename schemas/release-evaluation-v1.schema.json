      "title": "PromptBenchmarkValidationV1",
      "type": "object"
    },
    "PromptVariantKind": {
      "enum": [
        "exact",
        "partial",
        "ambiguous",
        "incorrect_structurally_plausible",
        "contradictory"
      ],
      "title": "PromptVariantKind",
      "type": "string"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
