{
  "$defs": {
    "ComparisonState": {
      "enum": [
        "equivalent",
        "different",
        "indeterminate",
        "unsupported"
      ],
      "title": "ComparisonState",
      "type": "string"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Version and artifact information for one producing step.",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "SemanticComparisonV1": {
      "additionalProperties": false,
      "properties": {
        "equivalent_attachment_completion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equivalent Attachment Completion"
        },
        "equivalent_precursor_set": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equivalent Precursor Set"
        },
        "equivalent_reaction_centre": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equivalent Reaction Centre"
        },
        "equivalent_stereo_result": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equivalent Stereo Result"
        },
        "exact_semantic_equivalence": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact Semantic Equivalence"
        },
        "mismatch_categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mismatch Categories",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "synthaudit.semantic-comparison/1",
          "default": "synthaudit.semantic-comparison/1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ComparisonState"
        }
      },
      "required": [
        "state",
        "exact_semantic_equivalence",
        "equivalent_precursor_set",
        "equivalent_reaction_centre",
        "equivalent_attachment_completion",
        "equivalent_stereo_result"
      ],
      "title": "SemanticComparisonV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "semantically_equivalent",
        "equivalent_except_atom_map_renumbering",
        "equivalent_except_unspecified_stereo",
        "partially_representable",
        "unsupported",
        "indeterminate",
        "different"
      ],
      "title": "Classification",
      "type": "string"
    },
    "comparison": {
      "$ref": "#/$defs/SemanticComparisonV1"
    },
    "information_lost": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Information Lost",
      "type": "array"
    },
    "left_representation": {
      "minLength": 1,
      "title": "Left Representation",
      "type": "string"
    },
    "product_equivalent": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Product Equivalent"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "right_representation": {
      "minLength": 1,
      "title": "Right Representation",
      "type": "string"
    },
    "schema_version": {
      "const": "synthaudit.representation-conformance/1",
      "default": "synthaudit.representation-conformance/1",
      "title": "Schema Version",
      "type": "string"
    },
    "unsupported_cases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unsupported Cases",
      "type": "array"
    }
  },
  "required": [
    "left_representation",
    "right_representation",
    "classification",
    "product_equivalent",
    "comparison"
  ],
  "title": "RepresentationConformanceV1",
  "type": "object"
}
