    "ReactionIRV1": {
      "additionalProperties": false,
      "description": "Canonical representation of mapped-product to mapped-precursor edits.",
      "properties": {
        "atom_state_edits": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "set_atom_state": "#/$defs/SetAtomStateEdit",
                "set_explicit_hydrogen": "#/$defs/SetExplicitHydrogenEdit"
              },
              "propertyName": "edit_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SetAtomStateEdit"
              },
              {
                "$ref": "#/$defs/SetExplicitHydrogenEdit"
              }
            ]
          },
          "title": "Atom State Edits",
          "type": "array"
        },
        "attachment_edits": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "attach_fragment": "#/$defs/AttachFragmentEdit",
                "detach_fragment": "#/$defs/DetachFragmentEdit"
              },
              "propertyName": "edit_type"
            },
